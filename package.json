{
  "name": "rulego-doc",
  "version": "1.0.0",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/postbuild.mjs",
    "docs:preview": "vitepress preview docs --port 4173",
    "migrate": "node scripts/migrate.mjs",
    "audit": "node scripts/audit-urls.mjs && node scripts/audit-links.mjs",
    "deploy": "bash deploy.sh",
    "baiduPush": "node utils/baiduPush.js https://www.rulego.cc && bash baiduPush.sh"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "markdown-it-container": "^2.0.0",
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.41"
  }
}
